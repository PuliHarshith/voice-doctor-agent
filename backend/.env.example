# Copy to .env and fill in the two keys. Never commit .env.
ELEVENLABS_API_KEY=your_elevenlabs_api_key
GOOGLE_API_KEY=your_google_ai_studio_api_key

# Everything below is optional; the values shown are the defaults.

# Gemini model. Free-tier quotas are per model per day.
GEMINI_MODEL=gemini-3.5-flash-lite
# ElevenLabs voice (Sarah). Free plans must use a "premade" voice.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Speech-to-text tuning (suits English with an Indian accent)
STT_LANGUAGE=en
STT_MODEL=scribe_v2_realtime
# Silence (s) before a phrase counts as finished. Long while a phone number is expected (digit-group pauses),
# short otherwise. Raise if words get cut; lower for snappier replies.
VAD_STOP_SECS=1.0
VAD_FAST_STOP_SECS=0.5
# Max silence (s) before the bot answers when it thinks you may still be talking.
TURN_SILENCE_SECS=2.0

# SQLite file; a relative path is relative to backend/
DB_PATH=clinic.db
# Browser origins allowed to call the API (comma-separated)
PIPECAT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:7860,http://127.0.0.1:7860

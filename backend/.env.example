# Copy to .env and fill in. Never commit .env.
ELEVENLABS_API_KEY=
GOOGLE_API_KEY=
# Optional: Gemini model (default gemini-3.5-flash-lite). Free-tier quotas are per model per day.
GEMINI_MODEL=
# Optional speech-to-text tuning (defaults suit English with an Indian accent)
STT_LANGUAGE=en
STT_MODEL=scribe_v2_realtime
# Silence (s) before a phrase is sent off for transcription. Raise if words get cut; lower for snappier replies.
VAD_STOP_SECS=1.0
# Max silence (s) before the bot answers when it thinks you may still be talking.
TURN_SILENCE_SECS=2.0
# Optional: ElevenLabs voice ID (default: Sarah). Free plans must use a "premade" voice.
ELEVENLABS_VOICE_ID=

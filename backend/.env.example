# Copy to .env and fill in the two keys. Never commit .env.
ELEVENLABS_API_KEY=your_elevenlabs_api_key
GOOGLE_API_KEY=your_google_ai_studio_api_key

# Everything below is optional; the values shown are the defaults.

# Gemini model. Free-tier quotas are per model per day.
GEMINI_MODEL=gemini-3.5-flash-lite
# ElevenLabs voice (Sarah). Free plans must use a "premade" voice; Voice Library voices need a paid plan.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# 0..1. Lower stability = more expressive but less consistent; similarity = closeness to the original voice.
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75

# Speech-to-text: explicit English (auto-detect can flip to Hindi on an Indian accent) and the streaming model.
STT_LANGUAGE=en
STT_MODEL=scribe_v2_realtime

# Silero voice activity detection (VAD): decides when you start and stop talking.
# Speech probability (0..1) needed to count as voice. Lower catches quieter speech; too low and room noise counts.
VAD_CONFIDENCE=0.6
# Seconds of speech before "started talking" fires. Short so the start of a turn isn't missed.
VAD_START_SECS=0.15
# Seconds of silence before "stopped talking" fires, while a phone number is expected: long enough that the
# pauses between digit groups don't end the turn. Raise to 1.2 if numbers still arrive in pieces.
VAD_STOP_SECS=1.0
# The same, for every other turn: shorter so replies come sooner.
VAD_FAST_STOP_SECS=0.5
# Loudness (0..1) needed to count as voice. Low enough for a quiet laptop mic; raise it if noise triggers it.
VAD_MIN_VOLUME=0.4
# Words you must say to interrupt the bot while it talks, so a cough or "mm" doesn't cut it off.
INTERRUPT_MIN_WORDS=2
# 1 = log every speech start/stop, turn start/end and interruption (for tuning the values above).
DEBUG_AUDIO=0

# Max silence (s) before the bot answers when it thinks you may still be talking.
TURN_SILENCE_SECS=2.0

# SQLite file; a relative path is relative to backend/
DB_PATH=clinic.db
# Browser origins allowed to call the API (comma-separated)
PIPECAT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:7860,http://127.0.0.1:7860
